---
// @ts-ignore
import { Icon } from "astro-icon/components";
---

<!-- icons gathered from https://icon-sets.iconify.design/ -->

<div class="mt-24">
  <h2 class="text-center text-slate-500">Meeting your requirements</h2>
  <div class="flex gap-8 md:gap-20 items-center justify-center mt-10 flex-wrap">

    <Icon class="size-8 md:size-12" title="Switches & Sockets" name="mdi:power-socket-uk" />
    <Icon class="size-8 md:size-12" title="Electrical Conduits" name="ph_pipe-fill" />
    <Icon class="size-8 md:size-12" title="Plumbing Pipes" name="game-icons_pipes" />
    <Icon class="size-8 md:size-16" title="Cables" name="mdi:cable-data" />
    <Icon class="size-8 md:size-16" title="Capacitors" name="tabler_circuit-capacitor" />
    <Icon class="size-8 md:size-12" title="Detuned Reactors" name="game-icons_power-generator" />

  </div>
</div>
