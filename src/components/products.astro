---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

export type Filter = {
  id: string;
  label: string;
  applied: boolean;
};
type Props = {
  product: CollectionEntry<"products">;
  index: number;
};

const { product, index } = Astro.props;
---

